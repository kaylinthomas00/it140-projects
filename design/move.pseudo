# Project One Move Pseudocode

START move_player

    # TODO 1: Identify the information the movement process needs.
    SET current_room TO player's current location
    SET valid_directions TO list of connected rooms (North, South, East, West)

    # TODO 2: Prompt for and receive the player's movement command.
    OUTPUT "Enter direction (north, south, east, west): "
    INPUT player_direction

    # TODO 3: Validate whether the requested direction is available.
    IF player_direction IS IN valid_directions THEN
        
        # TODO 4: Describe what happens when the direction is valid.
        SET current_room TO connected_room in player_direction
        OUTPUT "You walk to the " + current_room + "."

    # TODO 5: Describe what happens when the direction is invalid.
    ELSE
        OUTPUT "You can't go that way! Choose a valid direction."
    ENDIF

    # TODO 6: Show how the process returns to the larger gameplay loop.
    RETURN to main game loop

END move_player
