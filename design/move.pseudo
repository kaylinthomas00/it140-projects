# Project One Move-Between-Rooms Pseudocode

# Identify information needed: Player's current room and directional input
SET current_room TO "Entrance Lobby"

WHILE true DO
    # Prompt for and receive player's movement command
    OUTPUT "You are in " + current_room
    OUTPUT "Enter direction (north, south, east, west) or 'exit' to quit: "
    INPUT player_direction

    # Validate whether the requested movement is possible
    IF player_direction IS "exit" THEN
        OUTPUT "Exiting game. Thanks for playing!"
        BREAK
    
    # Handle valid movement path
    ELSE IF player_direction IS valid for current_room THEN
        SET current_room TO connected_room
        OUTPUT "You walk to the " + current_room + "."
    
    # Handle invalid direction
    ELSE
        OUTPUT "You can't go that way! Choose a valid direction."
    ENDIF

ENDWHILE
